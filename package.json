{
  "name": "astro-emdash-sqlite-r2-starter",
  "version": "1.0.0",
  "private": true,
  "description": "Marketing + blog + docs starter with Astro and EmDash CMS (SQLite local / Dokploy + R2 in production)",
  "license": "MIT",
  "packageManager": "pnpm@10.34.5",
  "type": "module",
  "engines": {
    "node": "24.0.0",
    "pnpm": "10.34.5"
  },
  "emdash": {
    "seed": "seed/seed.json"
  },
  "scripts": {
    "dev": "emdash dev",
    "build": "astro build",
    "start": "node ./dist/server/entry.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "types:cms": "emdash types",
    "export-seed": "emdash export-seed",
    "set-site-url": "node scripts/set-site-url.mjs",
    "set-url-patterns": "node scripts/set-url-patterns.mjs",
    "lint": "pnpm run lint:js && pnpm run lint:css && pnpm run type-check && pnpm run check:kpis && pnpm run validate:i18n && pnpm run validate:secrets",
    "lint:js": "eslint . --ignore-pattern dist --ignore-pattern .astro --ignore-pattern node_modules",
    "lint:css": "stylelint src/styles/",
    "check:kpis": "node scripts/check-kpis.mjs",
    "type-check": "astro check",
    "format": "prettier --write 'src/**/*.{astro,ts,tsx,css}'",
    "format:check": "prettier --check 'src/**/*.{astro,ts,tsx,css}'",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "validate:i18n": "node scripts/validate-i18n.js",
    "validate:secrets": "node scripts/validate-secrets.cjs"
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.8",
    "@astrojs/node": "^11.1.4",
    "@astrojs/react": "^6.0.4",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@aws-sdk/client-s3": "^3.1111.0",
    "@aws-sdk/s3-request-presigner": "^3.1111.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "@iconify-json/lucide": "^1.2.123",
    "@iconify-json/simple-icons": "^1.2.93",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.2.9",
    "astro-icon": "^1.2.0",
    "better-sqlite3": "^12.8.0",
    "clsx": "^2.1.1",
    "cva": "1.0.0-beta.8",
    "emdash": "^0.33.0",
    "react": "19",
    "react-dom": "19",
    "schema-dts": "^2.0.0",
    "sharp": "^0.35.3",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/starlight": "^0.41.9",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "astro-eslint-parser": "^3.1.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.1.0",
    "globals": "^17.11.0",
    "pagefind": "^1.5.2",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "stylelint": "^17.14.1",
    "stylelint-config-recommended-scss": "^17.0.1",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  }
}
