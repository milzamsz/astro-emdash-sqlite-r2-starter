# Environment variables
# ---------------------------------------------------------------------------
# Local dev: copy to .env (not committed) — SQLite + local file storage work
# with zero configuration.
# Production (Dokploy): set these in the service's Environment settings.
# Secrets (R2 keys) must never be committed.

# --- Site -----------------------------------------------------------------
# Public production URL. Falls back to http://localhost:4321 in dev.
# Canonical/OG/sitemap also read src/config/site.config.ts (url).
SITE_URL=

# --- EmDash database (SQLite) ---------------------------------------------
# Local dev and production both use SQLite. The default path lives under ./data
# so it can be backed by a persistent Dokploy volume. Override if needed.
# DATABASE_URL=file:./data/emdash.db

# --- EmDash media storage (Cloudflare R2 via the S3 API) ------------------
# Leave S3_BUCKET empty to use local filesystem storage (./data/uploads) in dev.
# Set all of the following in production to store uploads in Cloudflare R2.
# S3_ENDPOINT is the R2 S3 endpoint, e.g. https://<accountid>.r2.cloudflarestorage.com
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# R2 ignores region; "auto" is fine.
S3_REGION=auto
# Optional. EmDash serves all media through its own same-origin proxy route
# (/_emdash/api/media/file/<key>), which streams the object out of R2, keeps the
# bucket private, and sandboxes every file. The admin Media Library always shows
# that proxy path regardless of this value, so leaving it empty is recommended.
# S3_PUBLIC_URL=

# --- Email (Resend) -------------------------------------------------------
# Powers EmDash magic-link login, team invites, recovery, and notifications.
# When RESEND_API_KEY is set, the Resend provider is registered and (being the
# only provider) auto-selected — no admin dashboard configuration needed.
# Leave empty to fall back to copy-link invites.
# Create a key at https://resend.com/api-keys and verify your sending domain.
RESEND_API_KEY=
# Verified sender. Plain address or "Display Name <noreply@example.com>".
EMAIL_FROM=

# --- Security headers (optional) ------------------------------------------
# The app sends a strict CSP + HSTS/X-Frame-Options/etc. on the public site via
# src/middleware/security-headers.ts. Set to 1 to disable (e.g. when your CDN or
# reverse proxy already manages these headers).
# DISABLE_SECURITY_HEADERS=

# --- SEO verification (optional) ------------------------------------------
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# --- Analytics & consent (optional, client-side) --------------------------
PUBLIC_GA_MEASUREMENT_ID=
PUBLIC_GTM_ID=
PUBLIC_CONSENT_ENABLED=false
PUBLIC_PRIVACY_POLICY_URL=
