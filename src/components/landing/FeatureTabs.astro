---
export interface FeatureTab {
  id: string;
  icon: string;
  heading: string;
  description: string;
  points?: string[];
  visual: string;
}

interface Props {
  tabs: FeatureTab[];
}

const { tabs } = Astro.props as Props;

// Inline SVG path data for the small tab icons (previously rendered by React).
const ICON_PATHS: Record<string, string> = {
  zap: '<path d="M4 14a1 1 0 0 1-.78-1.63l9.9-10.2a.5.5 0 0 1 .86.46l-1.92 6.02A1 1 0 0 0 13 10h7a1 1 0 0 1 .78 1.63l-9.9 10.2a.5.5 0 0 1-.86-.46l1.92-6.02A1 1 0 0 0 11 14z" />',
  "pen-line":
    '<path d="M12 20h9" /><path d="M16.376 3.622a1 1 0 0 1 3.002 3.002L7.368 18.635a2 2 0 0 1-.855.506l-2.872.838a.5.5 0 0 1-.62-.62l.838-2.872a2 2 0 0 1 .506-.854z" />',
  "trending-up": '<path d="M16 7h6v6" /><path d="m22 7-8.5 8.5-5-5L2 17" />',
};
---

{
  tabs.length > 0 && (
    <section class="feature-tabs" data-feature-tabs>
      <div class="feature-tabs__list" role="tablist" aria-label="Feature tabs">
        {tabs.map((tab, index) => (
          <button
            id={`tab-${tab.id}`}
            type="button"
            role="tab"
            aria-selected={index === 0 ? "true" : "false"}
            aria-controls={`panel-${tab.id}`}
            tabindex={index === 0 ? 0 : -1}
            class:list={["feature-tabs__tab", index === 0 && "is-active"]}
          >
            <span class="feature-tabs__tab-icon">
              <svg
                class="feature-tabs__icon"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                focusable="false"
                set:html={ICON_PATHS[tab.icon] ?? ""}
              />
            </span>
            <span class="feature-tabs__tab-label">{tab.heading}</span>
          </button>
        ))}
      </div>

      {tabs.map((tab, index) => (
        <div
          id={`panel-${tab.id}`}
          role="tabpanel"
          aria-labelledby={`tab-${tab.id}`}
          class="feature-tabs__panel"
          tabindex="0"
          hidden={index !== 0}
        >
          <div class="feature-tabs__content">
            <h3 class="feature-tabs__heading">{tab.heading}</h3>
            <p class="feature-tabs__description">{tab.description}</p>
            {tab.points && tab.points.length > 0 && (
              <ul class="feature-tabs__points">
                {tab.points.map((point) => (
                  <li>
                    <svg
                      class="feature-tabs__check"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                      focusable="false"
                    >
                      <path d="M20 6 9 17l-5-5" />
                    </svg>
                    <span>{point}</span>
                  </li>
                ))}
              </ul>
            )}
          </div>
          <div class="feature-tabs__window" aria-hidden="true">
            <div class="feature-tabs__window-bar">
              <span />
              <span />
              <span />
            </div>
            <pre class="feature-tabs__visual">{tab.visual}</pre>
          </div>
        </div>
      ))}
    </section>
  )
}

<style>
  /* `.feature-tabs__panel` sets `display: grid`, which would override the
     default `[hidden]` behaviour, so hide inactive panels explicitly. */
  .feature-tabs__panel[hidden] {
    display: none;
  }
</style>

<script>
  function initFeatureTabs(root: HTMLElement) {
    const tabs = Array.from(
      root.querySelectorAll<HTMLButtonElement>('[role="tab"]'),
    );
    const panels = Array.from(
      root.querySelectorAll<HTMLElement>('[role="tabpanel"]'),
    );
    if (tabs.length === 0) return;

    function activate(index: number, focus = false) {
      tabs.forEach((tab, i) => {
        const selected = i === index;
        tab.setAttribute("aria-selected", selected ? "true" : "false");
        tab.tabIndex = selected ? 0 : -1;
        tab.classList.toggle("is-active", selected);
        if (selected && focus) tab.focus();
      });
      panels.forEach((panel, i) => {
        panel.hidden = i !== index;
      });
    }

    tabs.forEach((tab, index) => {
      tab.addEventListener("click", () => activate(index));
    });

    root
      .querySelector('[role="tablist"]')
      ?.addEventListener("keydown", (event) => {
        const e = event as KeyboardEvent;
        if (e.key !== "ArrowLeft" && e.key !== "ArrowRight") return;
        e.preventDefault();
        const current = tabs.findIndex(
          (t) => t.getAttribute("aria-selected") === "true",
        );
        const delta = e.key === "ArrowRight" ? 1 : -1;
        activate((current + delta + tabs.length) % tabs.length, true);
      });
  }

  document
    .querySelectorAll<HTMLElement>("[data-feature-tabs]")
    .forEach(initFeatureTabs);
</script>
