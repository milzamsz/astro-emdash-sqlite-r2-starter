---
import BaseLayout from "../layouts/BaseLayout.astro";
import { t } from "../i18n/ui";
import Hero from "../components/Hero.astro";
import FeatureGrid from "../components/FeatureGrid.astro";
import CTA from "../components/CTA.astro";
import { getPage } from "../lib/cms";

const locale = (Astro.currentLocale || "en") as "en";

const page = await getPage("about");

const hero = page?.data.hero;
const cta = page?.data.cta;
const featureItems = page?.data.features ?? [];
const featuresTitle = page?.data.featuresTitle;
const featureColumns = featureItems.length % 2 === 0 ? 2 : 3;
---

<BaseLayout
  title={page?.data.title || t(locale, "nav.about")}
  description={page?.data.description}
  locale={locale}
  path={"/about"}
>
  {
    hero && (
      <Hero
        variant="centered"
        size="md"
        eyebrow="About"
        title={hero.title || page?.data.title || ""}
        content={hero.subtitle}
        locale={locale}
      />
    )
  }
  {
    featureItems.length > 0 && (
      <FeatureGrid
        title={featuresTitle}
        columns={featureColumns}
        features={featureItems}
      />
    )
  }
  {
    cta && (
      <CTA
        title={cta.title || ""}
        content={cta.text}
        ctaText={cta.button}
        ctaHref={cta.href}
        locale={locale}
      />
    )
  }
</BaseLayout>
